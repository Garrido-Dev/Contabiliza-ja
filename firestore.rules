rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && userId is string
        && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isOwner(resource.data.userId);
    }

    function ownerIsUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isShareOwner(shareId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/quoteShares/$(shareId)).data.userId
          == request.auth.uid;
    }

    function isShareOwnerAfterWrite(shareId) {
      return isAuthenticated()
        && getAfter(/databases/$(database)/documents/quoteShares/$(shareId)).data.userId
          == request.auth.uid;
    }

    function hasOnlyPublicQuoteFields() {
      return request.resource.data.keys().hasOnly([
          'clientName',
          'type',
          'description',
          'items',
          'totalValue',
          'createdAt',
          'deadline',
          'paymentTerms',
          'whatsapp'
        ])
        && request.resource.data.keys().hasAll([
          'clientName',
          'type',
          'description',
          'items',
          'totalValue',
          'createdAt',
          'deadline',
          'paymentTerms',
          'whatsapp'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.type is string
        && request.resource.data.description is string
        && request.resource.data.items is list
        && request.resource.data.totalValue is number
        && request.resource.data.whatsapp is string;
    }

    // Perfil privado; cada usuário só pode acessar o próprio documento.
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
    }

    // ── Coleção de Clientes ──────────────────────────────────
    match /clients/{clientId} {
      allow read, delete: if isDocOwner();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isDocOwner() && ownerIsUnchanged();
    }

    // ── Coleção de Consultorias / Orçamentos ─────────────────
    match /quotes/{quoteId} {
      allow read, delete: if isDocOwner();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isDocOwner() && ownerIsUnchanged();

      match /privateNotes/{noteId} {
        function ownsParentQuote() {
          return isOwner(
            get(/databases/$(database)/documents/quotes/$(quoteId)).data.userId
          );
        }

        function ownsParentQuoteAfterWrite() {
          return isOwner(
            getAfter(/databases/$(database)/documents/quotes/$(quoteId)).data.userId
          );
        }

        allow read, delete: if ownsParentQuote() && isDocOwner();
        allow create: if ownsParentQuoteAfterWrite()
          && isOwner(request.resource.data.userId);
        allow update: if ownsParentQuote()
          && isDocOwner()
          && ownerIsUnchanged();
      }
    }

    // Mapeamento privado: shareId -> dono e orçamento correspondente.
    match /quoteShares/{shareId} {
      allow get: if isDocOwner();
      allow list: if false;
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.quoteId is string
        && request.resource.data.keys().hasOnly(['userId', 'quoteId'])
        && getAfter(
          /databases/$(database)/documents/quotes/$(request.resource.data.quoteId)
        ).data.userId == request.auth.uid;
      allow update: if isDocOwner()
        && ownerIsUnchanged()
        && request.resource.data.quoteId == resource.data.quoteId
        && request.resource.data.keys().hasOnly(['userId', 'quoteId']);
      allow delete: if isDocOwner();
    }

    // Cópia pública estritamente limitada ao que aparece na proposta do cliente.
    match /publicQuotes/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if isShareOwnerAfterWrite(shareId)
        && hasOnlyPublicQuoteFields();
      allow update: if isShareOwner(shareId)
        && hasOnlyPublicQuoteFields();
      allow delete: if isShareOwner(shareId);
    }

    // ── Coleção de Documentos GED ────────────────────────────
    match /documents/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isDocOwner() && ownerIsUnchanged();
    }

    // ── Coleção de Obrigações Fiscais ────────────────────────
    match /obligations/{obligationId} {
      allow read, delete: if isDocOwner();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isDocOwner() && ownerIsUnchanged();
    }

    // ── Bloqueio Padrão para Qualquer Outra Coleção ──────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
